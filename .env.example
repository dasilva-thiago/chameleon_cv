DATABASE_URL=postgresql://chameleon@127.0.0.1:54329/chameleon_dev
# Neon (opcional): `neon deploy` / `neon env pull` gravam DATABASE_URL (pooled, usada pelo app) e
# DATABASE_URL_UNPOOLED (direta, usada pelo CLI do Prisma nas migrations) no .env. O Postgres local fica
# em DATABASE_URL_LOCAL para voltar quando quiser. TEST_DATABASE_ADMIN_URL continua sempre local.
# DATABASE_URL_UNPOOLED=
# DATABASE_URL_LOCAL=postgresql://chameleon@127.0.0.1:54329/chameleon_dev
TEST_DATABASE_ADMIN_URL=postgresql://chameleon@127.0.0.1:54329/postgres
APP_ORIGIN=http://localhost:5173
API_PORT=3000
SIGNUP_MODE=invite
STORAGE_ROOT=.data/storage
UPLOAD_MAX_BYTES=2097152
AI_PROVIDER=deterministic
AI_MODEL=
AI_DAILY_TOKEN_LIMIT_PER_USER=200000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PDF_BROWSER=bundled
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (0 = none). In production behind a
# reverse proxy set it to the number of trusted hops (usually 1). The proxy must overwrite or
# append X-Forwarded-For and be the only path to the API (see apps/api/README.md, "Proxy contract").
TRUST_PROXY=0
# Required in production when TRUST_PROXY=0 (API reached directly, no reverse proxy). Leave false otherwise.
TRUST_PROXY_ACK_DIRECT=false
# Policy text versions accepted for the profile_processing consent (comma-separated, first = current).
# Must include DEFAULT_PROFILE_POLICY_VERSION / VITE_PROFILE_POLICY_VERSION of apps/web.
PROFILE_POLICY_VERSIONS=2026-11.1
JSON_BODY_LIMIT_BYTES=102400
