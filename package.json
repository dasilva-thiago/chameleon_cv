{
  "name": "chameleon-cv",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma universal de adaptacao de curriculos a vagas, baseada em um perfil profissional estruturado.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "pnpm --filter @chameleon/db generate",
    "dev": "pnpm --parallel --filter @chameleon/api --filter @chameleon/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "contracts:generate": "pnpm --filter @chameleon/contracts generate",
    "contracts:check": "pnpm --filter @chameleon/contracts check",
    "db:local:init": "node scripts/dev-db.mjs init",
    "db:local:start": "node scripts/dev-db.mjs start",
    "db:local:stop": "node scripts/dev-db.mjs stop",
    "db:local:status": "node scripts/dev-db.mjs status",
    "db:generate": "pnpm --filter @chameleon/db exec prisma generate",
    "db:migrate": "pnpm --filter @chameleon/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @chameleon/db exec prisma migrate deploy",
    "db:reset": "node scripts/assert-local-db.mjs && pnpm --filter @chameleon/db exec prisma migrate reset --force",
    "db:seed": "pnpm --filter @chameleon/db seed",
    "db:seed:pilot": "pnpm --filter @chameleon/db seed:pilot",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm contracts:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "jszip": "^3.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unpdf": "^2.1.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
