// Historico do perfil (ADR-0006, ADR-0004): revisoes imutaveis (snapshot + hash canonico) e
// registros de importacao (versoes de origem/destino, passos, avisos, mapa de ids).

enum RevisionReason {
  manual_save
  import
  pre_generation
  migration
}

enum ImportStatus {
  preview
  applied
  discarded
}

enum ImportSourceFormat {
  yaml
  json
  object
  markdown
}

enum ImportMode {
  strict
  lenient
}

/// Snapshot IMUTAVEL do ProfileDocument (trigger: UPDATE/DELETE falham; excecao `chameleon.allow_purge`).
/// `MatchAnalysis`/`ResumeVersion` (S3.0) referenciam ids DENTRO do snapshot, sem FK para linhas vivas.
model ProfileRevision {
  id             String         @id @default(uuid(7)) @db.Uuid
  ownerId        String         @db.Uuid
  profileId      String         @db.Uuid
  /// Sequencial por perfil, a partir de 1.
  revisionNumber Int
  /// Versao do contrato do snapshot (2.0.0 em revisoes antigas; 2.1.0 corrente).
  schemaVersion  String
  /// SHA-256 hex do JSON canonico (RFC 8785) do documento canonico.
  contentHash    String
  reason         RevisionReason
  snapshot       Json
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  profile ProfessionalProfile @relation(fields: [profileId, ownerId], references: [id, ownerId], onDelete: Cascade)

  imports ImportRecord[]

  @@unique([id, ownerId])
  @@unique([profileId, revisionNumber])
  @@index([ownerId, profileId, createdAt(sort: Desc)])
}

/// Importacao (ADR-0013): relatorio do pipeline de `profile-io` persistido. `idMap` (id local -> UUID)
/// torna a reimportacao idempotente. `unmapped` guarda valores descartados: dado do dono.
model ImportRecord {
  id                  String             @id @default(uuid(7)) @db.Uuid
  ownerId             String             @db.Uuid
  profileId           String             @db.Uuid
  sourceFormat        ImportSourceFormat
  /// NULL quando a versao nao pode ser detectada.
  sourceSchemaVersion String?
  targetSchemaVersion String
  mode                ImportMode         @default(strict)
  status              ImportStatus       @default(preview)
  steps               Json               @default("[]")
  warnings            Json               @default("[]")
  errors              Json               @default("[]")
  idMap               Json               @default("{}")
  unmapped            Json               @default("[]")
  /// Contagens da aplicacao (criados/atualizados/inalterados/arquivados por tipo).
  summary             Json               @default("{}")
  /// Revisao criada ao aplicar.
  revisionId          String?            @db.Uuid
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  appliedAt           DateTime?          @db.Timestamptz(3)

  profile  ProfessionalProfile @relation(fields: [profileId, ownerId], references: [id, ownerId], onDelete: Cascade)
  revision ProfileRevision?    @relation(fields: [revisionId, ownerId], references: [id, ownerId], onDelete: NoAction)

  @@unique([id, ownerId])
  @@index([ownerId, profileId, createdAt(sort: Desc)])
}
