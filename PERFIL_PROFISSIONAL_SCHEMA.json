{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/professional-profile-1.0.0.json",
  "title": "Universal Professional Profile",
  "description": "Contract for importing and validating a person's reusable professional profile. Empty or missing fields must not be interpreted as negative facts.",
  "type": "object",
  "required": ["schema_version", "profile"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "locale": {"type": "string"},
    "profile": {
      "type": "object",
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "contact": {"$ref": "#/$defs/contact"},
        "positioning": {"$ref": "#/$defs/positioning"},
        "competency_examples": {"type": "array", "items": {"$ref": "#/$defs/competencyExample"}},
        "experiences": {"type": "array", "items": {"$ref": "#/$defs/experience"}},
        "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
        "education": {"type": "array", "items": {"$ref": "#/$defs/education"}},
        "courses": {"type": "array", "items": {"$ref": "#/$defs/course"}},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
        "developing_knowledge": {"type": "array", "items": {"$ref": "#/$defs/developingKnowledge"}},
        "languages": {"type": "array", "items": {"$ref": "#/$defs/language"}},
        "certifications": {"type": "array", "items": {"$ref": "#/$defs/certification"}},
        "awards": {"type": "array", "items": {"$ref": "#/$defs/award"}},
        "publications_research_talks": {"type": "array", "items": {"$ref": "#/$defs/publication"}},
        "volunteering_and_leadership": {"type": "array", "items": {"$ref": "#/$defs/volunteering"}},
        "freelance_and_business": {"type": "array", "items": {"$ref": "#/$defs/freelance"}},
        "availability_preferences": {"$ref": "#/$defs/availability"},
        "career_preferences": {"$ref": "#/$defs/careerPreferences"},
        "resume_preferences": {"$ref": "#/$defs/resumePreferences"},
        "additional_professional_context": {"$ref": "#/$defs/additionalContext"},
        "evidence_registry": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "pending_items": {"type": "array", "items": {"$ref": "#/$defs/pendingItem"}},
        "usage_rules": {"$ref": "#/$defs/usageRules"},
        "review": {"$ref": "#/$defs/review"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "factStatus": {"type": "string", "enum": ["confirmed", "needs_review", "conflicting", "archived"]},
    "visibility": {"type": "string", "enum": ["public", "private", "conditional"]},
    "level": {"type": "string", "enum": ["not_assessed", "exposure", "basic", "intermediate", "advanced", "expert"]},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "nullableString": {"type": ["string", "null"]},
    "identity": {
      "type": "object",
      "properties": {
        "full_name": {"type": "string"}, "preferred_name": {"type": "string"},
        "pronunciation": {"type": "string"}, "pronouns": {"type": "string"},
        "country_of_residence": {"type": "string"}, "city": {"type": "string"},
        "region": {"type": "string"}, "country_of_work_interest": {"$ref": "#/$defs/stringArray"},
        "timezone": {"type": "string"}, "interface_languages": {"$ref": "#/$defs/stringArray"}
      }, "additionalProperties": true
    },
    "contact": {
      "type": "object",
      "properties": {
        "professional_email": {"type": "string"}, "phone": {"type": "string"},
        "links": {"type": "array", "items": {"type": "object", "properties": {
          "type": {"type": "string"}, "label": {"type": "string"}, "url": {"type": "string"},
          "visibility": {"$ref": "#/$defs/visibility"}, "include_by_default": {"type": "boolean"}, "notes": {"type": "string"}
        }, "additionalProperties": true}}
      }, "additionalProperties": true
    },
    "positioning": {
      "type": "object",
      "properties": {
        "current_profession": {"type": "string"}, "current_job_title": {"type": "string"},
        "current_seniority": {"type": "string"}, "professional_headline": {"type": "string"},
        "one_sentence_intro": {"type": "string"}, "short_summary": {"type": "string"},
        "full_summary": {"type": "string"}, "career_narrative": {"type": "string"},
        "primary_fields": {"$ref": "#/$defs/stringArray"}, "secondary_fields": {"$ref": "#/$defs/stringArray"},
        "preferred_job_titles": {"$ref": "#/$defs/stringArray"}, "excluded_job_titles": {"$ref": "#/$defs/stringArray"},
        "industries_of_interest": {"$ref": "#/$defs/stringArray"}, "industries_to_avoid": {"$ref": "#/$defs/stringArray"},
        "professional_interests": {"$ref": "#/$defs/stringArray"}, "preferred_problems_to_solve": {"$ref": "#/$defs/stringArray"},
        "short_term_goals": {"type": "string"}, "long_term_goals": {"type": "string"},
        "demonstrable_differentiators": {"$ref": "#/$defs/stringArray"}, "professional_values": {"$ref": "#/$defs/stringArray"}
      }, "additionalProperties": true
    },
    "competencyExample": {"type": "object", "properties": {
      "competency": {"type": "string"}, "situation": {"type": "string"}, "action": {"type": "string"},
      "outcome_or_learning": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "responsibility": {"type": "object", "properties": {
      "description": {"type": "string"}, "frequency": {"type": "string"}, "autonomy": {"type": "string"},
      "tools": {"$ref": "#/$defs/stringArray"}, "outcome": {"type": "string"}
    }, "additionalProperties": true},
    "achievement": {"type": "object", "properties": {
      "description": {"type": "string"}, "metric_name": {"type": "string"}, "metric_value": {"type": "string"},
      "baseline": {"type": "string"}, "period": {"type": "string"}, "calculation_method": {"type": "string"},
      "personal_contribution": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"},
      "public_disclosure": {"type": "string"}
    }, "additionalProperties": true},
    "experience": {"type": "object", "properties": {
      "id": {"type": "string"}, "organization": {"type": "string"}, "organization_public_name": {"type": "string"},
      "industry": {"type": "string"}, "location": {"type": "object"}, "official_title": {"type": "string"},
      "resume_display_title": {"type": "string"}, "employment_type": {"type": "string"}, "department": {"type": "string"},
      "start_date": {"type": "string"}, "end_date": {"type": ["string", "null"]}, "is_current": {"type": "boolean"},
      "work_mode": {"type": "string"}, "company_context": {"type": "string"}, "role_objective": {"type": "string"},
      "products_services_users": {"type": "string"}, "operational_scope": {"type": "string"},
      "team_interfaces": {"$ref": "#/$defs/stringArray"}, "responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}},
      "achievements": {"type": "array", "items": {"$ref": "#/$defs/achievement"}}, "internal_deliveries": {"type": "array", "items": {"type": "object"}},
      "technologies_used": {"type": "array", "items": {"type": "object"}},
      "transferable_skills": {"$ref": "#/$defs/stringArray"}, "lessons_learned": {"$ref": "#/$defs/stringArray"},
      "exit_reason_private": {"type": "string"}, "reference_contact_permission": {"type": "string"},
      "fact_status": {"$ref": "#/$defs/factStatus"}, "evidence_ids": {"$ref": "#/$defs/stringArray"}, "notes": {"type": "string"}
    }, "additionalProperties": true},
    "project": {"type": "object", "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "category": {"type": "string"}, "status": {"type": "string"},
      "start_date": {"type": "string"}, "end_date": {"type": ["string", "null"]}, "last_updated": {"type": "string"},
      "role": {"type": "string"}, "team_based": {"type": "boolean"}, "collaborators": {"type": "array", "items": {"type": "object"}},
      "personal_contribution": {"type": "string"}, "contributions_by_others": {"type": "string"}, "decision_ownership": {"type": "string"},
      "problem": {"type": "string"}, "target_audience": {"type": "string"}, "need_addressed": {"type": "string"},
      "proposed_solution": {"type": "string"}, "main_features": {"$ref": "#/$defs/stringArray"}, "workflows": {"$ref": "#/$defs/stringArray"},
      "business_rules": {"$ref": "#/$defs/stringArray"}, "constraints_and_decisions": {"$ref": "#/$defs/stringArray"},
      "architecture": {"type": "string"}, "frontend": {"$ref": "#/$defs/stringArray"}, "backend": {"$ref": "#/$defs/stringArray"},
      "databases": {"$ref": "#/$defs/stringArray"}, "apis_and_integrations": {"$ref": "#/$defs/stringArray"},
      "authentication_authorization": {"type": "string"}, "infrastructure_deployment": {"$ref": "#/$defs/stringArray"},
      "testing_quality": {"$ref": "#/$defs/stringArray"}, "security_privacy": {"$ref": "#/$defs/stringArray"},
      "observability": {"$ref": "#/$defs/stringArray"}, "documentation": {"$ref": "#/$defs/stringArray"},
      "methods_and_version_control": {"$ref": "#/$defs/stringArray"}, "technologies": {"type": "array", "items": {"type": "object"}},
      "deliverables": {"$ref": "#/$defs/stringArray"}, "outcomes": {"$ref": "#/$defs/stringArray"},
      "metrics": {"type": "array", "items": {"type": "object"}}, "tests_performed": {"$ref": "#/$defs/stringArray"},
      "feedback": {"$ref": "#/$defs/stringArray"}, "known_limitations": {"$ref": "#/$defs/stringArray"},
      "next_improvements": {"$ref": "#/$defs/stringArray"}, "learning": {"$ref": "#/$defs/stringArray"},
      "public_url": {"type": "string"}, "repository_url": {"type": "string"}, "documentation_url": {"type": "string"},
      "demo_url": {"type": "string"}, "license": {"type": "string"}, "is_public": {"type": "boolean"},
      "disclosure": {"type": "string"}, "one_line_description": {"type": "string"}, "short_description": {"type": "string"},
      "resume_keywords": {"$ref": "#/$defs/stringArray"}, "evidence_ids": {"$ref": "#/$defs/stringArray"},
      "fact_status": {"$ref": "#/$defs/factStatus"}, "notes": {"type": "string"}
    }, "additionalProperties": true},
    "education": {"type": "object", "properties": {
      "id": {"type": "string"}, "institution": {"type": "string"}, "course_name": {"type": "string"},
      "degree_type": {"type": "string"}, "field_of_study": {"type": "string"}, "status": {"type": "string"},
      "start_date": {"type": "string"}, "completion_date": {"type": ["string", "null"]},
      "expected_completion_date": {"type": ["string", "null"]}, "modality": {"type": "string"}, "location": {"type": "string"},
      "qualification_awarded": {"type": "string"}, "thesis_title": {"type": "string"}, "thesis_description": {"type": "string"},
      "supervisor": {"type": "string"}, "relevant_coursework": {"$ref": "#/$defs/stringArray"},
      "academic_projects": {"$ref": "#/$defs/stringArray"}, "honors_scholarships_distinctions": {"$ref": "#/$defs/stringArray"},
      "verification_url": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"},
      "fact_status": {"$ref": "#/$defs/factStatus"}, "notes": {"type": "string"}
    }, "additionalProperties": true},
    "course": {"type": "object", "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "provider": {"type": "string"},
      "topics": {"$ref": "#/$defs/stringArray"}, "start_date": {"type": "string"}, "completion_date": {"type": "string"},
      "workload_hours": {"type": ["number", "null"]}, "status": {"type": "string"}, "certificate_issued": {"type": "boolean"},
      "verification_url": {"type": "string"}, "main_topics": {"$ref": "#/$defs/stringArray"},
      "activities_projects": {"$ref": "#/$defs/stringArray"}, "skills_developed": {"$ref": "#/$defs/stringArray"},
      "relevant_job_families": {"$ref": "#/$defs/stringArray"}, "evidence_ids": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "skill": {"type": "object", "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "category": {"type": "string"}, "description": {"type": "string"},
      "self_assessed_level": {"$ref": "#/$defs/level"}, "acquisition_contexts": {"$ref": "#/$defs/stringArray"},
      "related_experience_ids": {"$ref": "#/$defs/stringArray"}, "related_project_ids": {"$ref": "#/$defs/stringArray"},
      "related_education_ids": {"$ref": "#/$defs/stringArray"}, "tasks_can_perform": {"$ref": "#/$defs/stringArray"},
      "last_used": {"type": "string"}, "duration_of_use": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"},
      "resume_usage": {"type": "string"}, "limitations": {"type": "string"}, "fact_status": {"$ref": "#/$defs/factStatus"}
    }, "additionalProperties": true},
    "developingKnowledge": {"type": "object", "properties": {
      "topic": {"type": "string"}, "study_scope": {"type": "string"}, "learning_sources": {"$ref": "#/$defs/stringArray"},
      "practical_project": {"type": "string"}, "perceived_level": {"type": "string"}, "next_goal": {"type": "string"}
    }, "additionalProperties": true},
    "language": {"type": "object", "properties": {
      "language": {"type": "string"}, "overall_level": {"type": "string"}, "reading": {"type": "string"},
      "writing": {"type": "string"}, "listening": {"type": "string"}, "speaking": {"type": "string"},
      "professional_usage": {"type": "string"}, "certification_name": {"type": "string"},
      "certification_score": {"type": "string"}, "assessment_date": {"type": "string"},
      "include_in_resume": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "certification": {"type": "object", "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "issuer": {"type": "string"}, "category": {"type": "string"},
      "issue_date": {"type": "string"}, "expiration_date": {"type": ["string", "null"]}, "public_identifier": {"type": "string"},
      "verification_url": {"type": "string"}, "related_skills": {"$ref": "#/$defs/stringArray"}, "status": {"type": "string"},
      "evidence_ids": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "award": {"type": "object", "properties": {
      "name": {"type": "string"}, "organization": {"type": "string"}, "date": {"type": "string"},
      "context_and_criteria": {"type": "string"}, "personal_contribution": {"type": "string"}, "scope": {"type": "string"},
      "evidence_ids": {"$ref": "#/$defs/stringArray"}, "disclosure": {"type": "string"}
    }, "additionalProperties": true},
    "publication": {"type": "object", "properties": {
      "title": {"type": "string"}, "type": {"type": "string"}, "date": {"type": "string"},
      "venue_or_institution": {"type": "string"}, "authorship": {"type": "string"}, "summary": {"type": "string"},
      "personal_contribution": {"type": "string"}, "topics_methods": {"$ref": "#/$defs/stringArray"},
      "url_or_doi": {"type": "string"}, "status": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "volunteering": {"type": "object", "properties": {
      "organization": {"type": "string"}, "role": {"type": "string"}, "participation_type": {"type": "string"},
      "start_date": {"type": "string"}, "end_date": {"type": ["string", "null"]},
      "responsibilities": {"$ref": "#/$defs/stringArray"}, "audience": {"type": "string"},
      "outcomes": {"$ref": "#/$defs/stringArray"}, "skills_demonstrated": {"$ref": "#/$defs/stringArray"},
      "evidence_ids": {"$ref": "#/$defs/stringArray"}, "disclosure": {"type": "string"}
    }, "additionalProperties": true},
    "freelance": {"type": "object", "properties": {
      "business_or_professional_name": {"type": "string"}, "activity": {"type": "string"},
      "start_date": {"type": "string"}, "end_date": {"type": ["string", "null"]},
      "client_market_description": {"type": "string"}, "services_scope": {"$ref": "#/$defs/stringArray"},
      "personal_responsibilities": {"$ref": "#/$defs/stringArray"}, "tools_technologies": {"$ref": "#/$defs/stringArray"},
      "deliveries": {"$ref": "#/$defs/stringArray"}, "verifiable_results": {"$ref": "#/$defs/stringArray"},
      "project_or_client_count": {"type": ["integer", "null"]}, "portfolio_url": {"type": "string"},
      "client_names_disclosure": {"type": "string"}, "evidence_ids": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "availability": {"type": "object", "properties": {
      "privacy": {"type": "string"}, "preferred_work_modes": {"$ref": "#/$defs/stringArray"},
      "accepted_work_modes": {"$ref": "#/$defs/stringArray"}, "target_regions_countries": {"$ref": "#/$defs/stringArray"},
      "willing_to_relocate": {"type": "string"}, "travel_availability": {"type": "string"},
      "start_availability": {"type": "string"}, "preferred_contract_types": {"$ref": "#/$defs/stringArray"},
      "preferred_workload": {"type": "string"}, "compatible_timezones_hours": {"type": "string"},
      "salary_expectation": {"type": "object", "properties": {
        "amount": {"type": ["number", "null"]}, "currency": {"type": "string"}, "period": {"type": "string"}, "notes": {"type": "string"}
      }, "additionalProperties": true}, "desired_benefits": {"$ref": "#/$defs/stringArray"},
      "work_environment_preferences": {"$ref": "#/$defs/stringArray"}, "work_conditions": {"$ref": "#/$defs/stringArray"},
      "deal_breakers": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "careerPreferences": {"type": "object", "properties": {
      "priority_job_titles": {"$ref": "#/$defs/stringArray"}, "secondary_job_titles": {"$ref": "#/$defs/stringArray"},
      "fields_of_interest": {"$ref": "#/$defs/stringArray"}, "preferred_industries": {"$ref": "#/$defs/stringArray"},
      "excluded_industries": {"$ref": "#/$defs/stringArray"}, "target_seniority_levels": {"$ref": "#/$defs/stringArray"},
      "accepted_equivalent_titles": {"$ref": "#/$defs/stringArray"}, "misleading_titles_to_avoid": {"$ref": "#/$defs/stringArray"},
      "preferred_responsibilities": {"$ref": "#/$defs/stringArray"}, "responsibilities_to_avoid": {"$ref": "#/$defs/stringArray"},
      "interest_in_adjacent_fields": {"type": "string"}
    }, "additionalProperties": true},
    "resumePreferences": {"type": "object", "properties": {
      "default_language": {"type": "string"}, "regional_variant": {"type": "string"}, "tone": {"type": "string"},
      "preferred_length": {"type": "string"}, "output_formats": {"$ref": "#/$defs/stringArray"}, "visual_style": {"type": "string"},
      "include_photo": {"type": "boolean"}, "default_headline": {"type": "string"},
      "preferred_sections": {"$ref": "#/$defs/stringArray"}, "sections_to_omit": {"$ref": "#/$defs/stringArray"},
      "older_experiences_to_summarize": {"$ref": "#/$defs/stringArray"}, "highlight_when_relevant": {"$ref": "#/$defs/stringArray"},
      "preferred_vocabulary": {"$ref": "#/$defs/stringArray"}, "expressions_to_avoid": {"$ref": "#/$defs/stringArray"},
      "additional_style_notes": {"type": "string"}
    }, "additionalProperties": true},
    "additionalContext": {"type": "object", "properties": {
      "industry_knowledge": {"$ref": "#/$defs/stringArray"}, "standards_regulations": {"$ref": "#/$defs/stringArray"},
      "specialized_equipment": {"$ref": "#/$defs/stringArray"}, "methods_processes_frameworks": {"$ref": "#/$defs/stringArray"},
      "international_experience": {"type": "string"}, "distributed_team_experience": {"type": "string"},
      "stakeholder_experience": {"type": "string"}, "other": {"type": "string"}
    }, "additionalProperties": true},
    "evidence": {"type": "object", "properties": {
      "id": {"type": "string"}, "type": {"type": "string"}, "title": {"type": "string"},
      "url_or_location": {"type": "string"}, "supported_claims": {"$ref": "#/$defs/stringArray"},
      "evidence_date": {"type": "string"}, "is_public": {"type": "boolean"},
      "approved_for_recruiter_sharing": {"type": "boolean"}, "notes": {"type": "string"}
    }, "additionalProperties": true},
    "pendingItem": {"type": "object", "properties": {
      "id": {"type": "string"}, "subject": {"type": "string"}, "current_information": {"type": "string"},
      "uncertainty_reason": {"type": "string"}, "known_variants": {"$ref": "#/$defs/stringArray"},
      "safe_statement_for_now": {"type": "string"}, "confirmation_method": {"type": "string"},
      "priority": {"type": "string", "enum": ["low", "medium", "high"]},
      "status": {"type": "string", "enum": ["open", "resolved", "ignored"]}
    }, "additionalProperties": true},
    "usageRules": {"type": "object", "properties": {
      "never_include_in_resume": {"$ref": "#/$defs/stringArray"},
      "require_approval_before_inclusion": {"$ref": "#/$defs/stringArray"},
      "confidential_employers_or_projects": {"$ref": "#/$defs/stringArray"},
      "links_not_to_share": {"$ref": "#/$defs/stringArray"},
      "private_career_guidance_only": {"$ref": "#/$defs/stringArray"},
      "additional_restrictions": {"$ref": "#/$defs/stringArray"}
    }, "additionalProperties": true},
    "review": {"type": "object", "properties": {
      "profile_created_date": {"type": "string"}, "last_reviewed_date": {"type": "string"},
      "reviewed_by": {"type": "string"}, "reviewed_sections": {"$ref": "#/$defs/stringArray"},
      "items_to_update": {"$ref": "#/$defs/stringArray"},
      "processing_consent": {"type": "string", "enum": ["granted", "denied", "not_recorded"]},
